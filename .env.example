# Database — use PostgreSQL (Heroku Postgres in production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Auth.js / NextAuth
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST="true"
# Set to your public URL in production, e.g. https://your-app.herokuapp.com
AUTH_URL="http://localhost:3000"

# Google OAuth
# Authorized redirect URI must include:
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR-APP.herokuapp.com/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Comma-separated admin emails
ADMIN_EMAILS="admin@example.com"
